#!/usr/bin/env bash
# Enable or disable the laptop touchpad using the same persistence path as
# omarchy-toggle-touchpad, so Hyprland reloads keep the chosen state.
#
# Usage: apply-touchpad <on|off> [--notify]

set -euo pipefail

ACTION="${1:-}"
NOTIFY=0
[[ ${2:-} == "--notify" ]] && NOTIFY=1

if [[ $ACTION != on && $ACTION != off ]]; then
  echo "Usage: apply-touchpad <on|off> [--notify]" >&2
  exit 1
fi

NAME_FILE="$HOME/.local/state/omarchy/toggles/hypr/touchpad-disabled-name"
MANAGED_FILE="$HOME/.local/state/omarchy/plugins/local.mouse-touchpad-toggle/managed"
device=$(omarchy-hw-touchpad 2>/dev/null || true)

if [[ -z $device ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

if [[ $device == *[[:cntrl:]]* ]]; then
  echo "Invalid touchpad device name" >&2
  exit 1
fi

quoted=${device//\\/\\\\}
quoted=${quoted//\"/\\\"}

if [[ $ACTION == off ]]; then
  hyprctl eval "hl.device({ name = \"$quoted\", enabled = false })" >/dev/null
  mkdir -p "$(dirname "$NAME_FILE")"
  mkdir -p "$(dirname "$MANAGED_FILE")"
  printf '%s\n' "$device" >"$NAME_FILE"
  printf '1\n' >"$MANAGED_FILE"
  if (( NOTIFY )); then
    omarchy-osd -i touchpad -m "Touchpad disabled" 2>/dev/null || true
  fi
else
  rm -f "$NAME_FILE"
  rm -f "$MANAGED_FILE"
  hyprctl eval "hl.device({ name = \"$quoted\", enabled = true })" >/dev/null
  if (( NOTIFY )); then
    omarchy-osd -i touchpad -m "Touchpad enabled" 2>/dev/null || true
  fi
fi

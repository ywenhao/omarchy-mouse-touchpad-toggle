#!/usr/bin/env bash
# Detect connected mice via udev properties (not Hyprland name heuristics).
# A device counts as a mouse when ID_INPUT_MOUSE=1 and it is not a touchpad
# or pointing stick. Output is a single JSON object on stdout.

set -euo pipefail

usb=0
bluetooth=0
other=0
devices_json="["
first=1

json_escape() {
  local raw=$1
  raw=${raw//\\/\\\\}
  raw=${raw//\"/\\\"}
  printf '%s' "$raw"
}

prop() {
  # Usage: prop "$props" KEY
  printf '%s\n' "$1" | sed -n "s/^${2}=//p" | head -n1
}

for event in /dev/input/event*; do
  [[ -e $event ]] || continue

  props=$(udevadm info -q property -n "$event" 2>/dev/null) || continue

  [[ $(prop "$props" ID_INPUT_MOUSE) == 1 ]] || continue
  [[ $(prop "$props" ID_INPUT_TOUCHPAD) == 1 ]] && continue
  [[ $(prop "$props" ID_INPUT_POINTINGSTICK) == 1 ]] && continue

  bus=$(prop "$props" ID_BUS)
  [[ -n $bus ]] || bus="other"

  name=$(prop "$props" NAME)
  name=${name#\"}
  name=${name%\"}
  name=$(printf '%s' "$name" | sed 's/[[:space:]]*$//')

  # event nodes often lack NAME; fall back to model / serial / parent input.
  if [[ -z $name ]]; then
    name=$(prop "$props" ID_MODEL)
    name=${name//_/ }
  fi
  if [[ -z $name ]]; then
    name=$(prop "$props" ID_SERIAL)
    name=${name//_/ }
  fi
  if [[ -z $name ]]; then
    syspath=$(udevadm info -q path -n "$event" 2>/dev/null || true)
    if [[ -n $syspath ]]; then
      parent_props=$(udevadm info -q property -p "$(dirname "$syspath")" 2>/dev/null || true)
      name=$(prop "$parent_props" NAME)
      name=${name#\"}
      name=${name%\"}
      name=$(printf '%s' "$name" | sed 's/[[:space:]]*$//')
    fi
  fi
  [[ -n $name ]] || name=$(basename "$event")

  case "$bus" in
    usb) usb=$((usb + 1)) ;;
    bluetooth) bluetooth=$((bluetooth + 1)) ;;
    *)
      bus="other"
      other=$((other + 1))
      ;;
  esac

  if (( first )); then
    first=0
  else
    devices_json+=","
  fi
  devices_json+=$(printf '{"name":"%s","bus":"%s"}' "$(json_escape "$name")" "$(json_escape "$bus")")
done

devices_json+="]"
total=$((usb + bluetooth + other))

printf '{"usb":%s,"bluetooth":%s,"other":%s,"total":%s,"devices":%s}\n' \
  "$usb" "$bluetooth" "$other" "$total" "$devices_json"

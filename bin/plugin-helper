#!/usr/bin/python3
"""Bounded detector, config loader, and descriptor-safe state helper."""

import fcntl
import json
import os
import re
import secrets
import select
import stat
import subprocess
import sys
import time
from pathlib import Path


PLUGIN_ID = "dev.ywenhao.mouse-touchpad-toggle"
UID = os.geteuid()
HOME = Path.home()
STATE_PARENT = HOME / ".local" / "state" / "omarchy" / "plugins"
STATE_DIR_NAME = PLUGIN_ID
TOGGLE_PARENT = HOME / ".local" / "state" / "omarchy" / "toggles" / "hypr"
TOGGLE_NAME = "touchpad-disabled-name"
MANAGED_NAME = "managed"

MAX_CONFIG_BYTES = 16 * 1024
MAX_PATTERNS = 32
MAX_PATTERN_CHARS = 128
MAX_DEVICES = 64
MAX_DEVICE_NAME_CHARS = 128
MAX_JSON_BYTES = 64 * 1024
DETECT_DEADLINE_SECONDS = 2.0
UDEVADM_CALL_SECONDS = 0.35
MAX_UDEV_OUTPUT_BYTES = 512 * 1024
MAX_TOUCHPAD_STATE_BYTES = 1024
MAX_STATE_WRITE_BYTES = 4096

O_DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
SAFE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
EVENT_PATH = re.compile(r"^/dev/input/event[0-9]+$")


class HelperError(Exception):
    pass


def fail(message: str) -> None:
    print(f"plugin-helper: {message}", file=sys.stderr)
    raise SystemExit(1)


def open_verified_directory(path: Path, *, create: bool = False) -> int:
    """Open every component without following symlinks and verify ownership/mode."""
    input_path = Path(os.fspath(path))
    if not input_path.is_absolute() or any(part == ".." for part in input_path.parts):
        raise HelperError("unsafe directory path")
    path = Path(os.path.abspath(os.fspath(input_path)))
    fd = os.open("/", O_DIRECTORY)
    try:
        for part in path.parts[1:]:
            if not part or part in (".", ".."):
                raise HelperError("unsafe directory component")
            if create:
                try:
                    os.mkdir(part, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            next_fd = os.open(part, O_DIRECTORY, dir_fd=fd)
            os.close(fd)
            fd = next_fd
            info = os.fstat(fd)
            if not stat.S_ISDIR(info.st_mode):
                raise HelperError(f"{path} is not a directory")
            if info.st_uid not in (0, UID):
                raise HelperError(f"{path} has an unexpected owner")
            if (info.st_mode & 0o022) and not (info.st_mode & stat.S_ISVTX):
                raise HelperError(f"{path} has unsafe permissions")
        return fd
    except Exception:
        os.close(fd)
        raise


def lock_directory(dir_fd: int) -> int:
    """Take an owner-only advisory lock on a descriptor-relative leaf."""
    try:
        lock_fd = os.open(
            ".lock",
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            0o600,
            dir_fd=dir_fd,
        )
    except OSError as error:
        raise HelperError("cannot open state lock") from error
    info = os.fstat(lock_fd)
    if not stat.S_ISREG(info.st_mode) or info.st_uid != UID or info.st_mode & 0o022:
        os.close(lock_fd)
        raise HelperError("unsafe state lock")
    deadline = time.monotonic() + 2.0
    while True:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock_fd
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(lock_fd)
                raise HelperError("state lock deadline exceeded")
            time.sleep(0.02)
        except OSError as error:
            os.close(lock_fd)
            raise HelperError("cannot lock state") from error


def open_private_state_dir() -> int:
    parent_fd = open_verified_directory(STATE_PARENT, create=True)
    try:
        try:
            os.mkdir(STATE_DIR_NAME, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
        state_fd = os.open(STATE_DIR_NAME, O_DIRECTORY, dir_fd=parent_fd)
    finally:
        os.close(parent_fd)
    info = os.fstat(state_fd)
    if info.st_uid != UID:
        os.close(state_fd)
        raise HelperError("plugin state directory is not owned by the current user")
    if info.st_mode & 0o077:
        os.fchmod(state_fd, 0o700)
    return state_fd


def open_regular_at(dir_fd: int, name: str, max_bytes: int) -> int | None:
    if not SAFE_NAME.fullmatch(name):
        return None
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
    try:
        fd = os.open(name, flags, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    except OSError:
        return None
    info = os.fstat(fd)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != UID
        or info.st_mode & 0o022
        or info.st_size > max_bytes
    ):
        os.close(fd)
        return None
    return fd


def read_bounded(fd: int, max_bytes: int) -> bytes:
    chunks: list[bytes] = []
    total = 0
    while True:
        chunk = os.read(fd, min(4096, max_bytes + 1 - total))
        if not chunk:
            return b"".join(chunks)
        chunks.append(chunk)
        total += len(chunk)
        if total > max_bytes:
            raise HelperError("file exceeds byte limit")


def atomic_write_at(dir_fd: int, name: str, payload: bytes) -> None:
    if not SAFE_NAME.fullmatch(name):
        raise HelperError("unsafe state filename")
    if len(payload) > MAX_STATE_WRITE_BYTES:
        raise HelperError("state payload exceeds byte limit")
    temp_name = f".{name}.tmp.{os.getpid()}.{secrets.token_hex(8)}"
    temp_fd: int | None = None
    try:
        temp_fd = os.open(
            temp_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=dir_fd,
        )
        info = os.fstat(temp_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != UID:
            raise HelperError("unsafe temporary state file")
        view = memoryview(payload)
        while view:
            written = os.write(temp_fd, view)
            if written <= 0:
                raise HelperError("short state write")
            view = view[written:]
        os.fsync(temp_fd)
        os.close(temp_fd)
        temp_fd = None
        # The held directory descriptor keeps both names in the same verified
        # directory for the complete replacement transaction.
        os.replace(temp_name, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        temp_name = None
        os.fsync(dir_fd)
    finally:
        if temp_fd is not None:
            os.close(temp_fd)
        if temp_name is not None:
            try:
                os.unlink(temp_name, dir_fd=dir_fd)
            except OSError:
                pass


def unlink_at(dir_fd: int, name: str) -> None:
    try:
        os.unlink(name, dir_fd=dir_fd)
        os.fsync(dir_fd)
    except FileNotFoundError:
        pass


def marker_exists_at(state_fd: int) -> bool:
    fd = open_regular_at(state_fd, MANAGED_NAME, 16)
    if fd is None:
        return False
    try:
        return read_bounded(fd, 16).strip() == b"1"
    finally:
        os.close(fd)


def marker_exists() -> bool:
    state_fd = open_private_state_dir()
    lock_fd = lock_directory(state_fd)
    try:
        return marker_exists_at(state_fd)
    finally:
        os.close(lock_fd)
        os.close(state_fd)


def toggle_state_exists() -> bool:
    toggle_fd = open_verified_directory(TOGGLE_PARENT, create=True)
    try:
        fd = open_regular_at(toggle_fd, TOGGLE_NAME, MAX_TOUCHPAD_STATE_BYTES)
        if fd is None:
            return False
        try:
            value = read_bounded(fd, MAX_TOUCHPAD_STATE_BYTES).decode("utf-8", errors="strict").strip()
            return bool(value) and len(value) <= MAX_DEVICE_NAME_CHARS and not any(
                ord(char) < 32 or 0x7F <= ord(char) <= 0x9F for char in value
            )
        except (UnicodeError, HelperError):
            return False
        finally:
            os.close(fd)
    finally:
        os.close(toggle_fd)


def state_snapshot() -> dict[str, bool]:
    state_fd = open_private_state_dir()
    state_lock_fd = lock_directory(state_fd)
    try:
        return {
            "managed": marker_exists_at(state_fd),
            "disabled": toggle_state_exists(),
        }
    finally:
        os.close(state_lock_fd)
        os.close(state_fd)


def set_managed(value: bool, state_fd: int | None = None) -> None:
    owns_lock = state_fd is None
    if owns_lock:
        state_fd = open_private_state_dir()
        lock_fd = lock_directory(state_fd)
    else:
        lock_fd = None
    try:
        if value:
            atomic_write_at(state_fd, MANAGED_NAME, b"1\n")
        else:
            unlink_at(state_fd, MANAGED_NAME)
    finally:
        if owns_lock:
            os.close(lock_fd)
            os.close(state_fd)


def write_touchpad_state(device: str, state_fd: int | None = None) -> None:
    if (
        not device
        or len(device) > MAX_DEVICE_NAME_CHARS
        or any(ord(char) < 32 or 0x7F <= ord(char) <= 0x9F for char in device)
    ):
        raise HelperError("invalid touchpad device name")
    owns_state_lock = state_fd is None
    if owns_state_lock:
        state_fd = open_private_state_dir()
        state_lock_fd = lock_directory(state_fd)
    else:
        state_lock_fd = None
    toggle_fd = open_verified_directory(TOGGLE_PARENT, create=True)
    try:
        atomic_write_at(toggle_fd, TOGGLE_NAME, device.encode("utf-8") + b"\n")
    finally:
        os.close(toggle_fd)
        if owns_state_lock:
            os.close(state_lock_fd)
            os.close(state_fd)


def remove_touchpad_state(state_fd: int | None = None) -> None:
    owns_state_lock = state_fd is None
    if owns_state_lock:
        state_fd = open_private_state_dir()
        state_lock_fd = lock_directory(state_fd)
    else:
        state_lock_fd = None
    toggle_fd = open_verified_directory(TOGGLE_PARENT, create=True)
    try:
        unlink_at(toggle_fd, TOGGLE_NAME)
    finally:
        os.close(toggle_fd)
        if owns_state_lock:
            os.close(state_lock_fd)
            os.close(state_fd)


def parse_config(plugin_dir: Path) -> dict:
    defaults = {
        "disableOnUsbMouse": True,
        "disableOnBluetoothMouse": True,
        "disableOnOtherMouse": False,
        "restoreOnDisconnect": True,
        "notify": False,
        "ignoreNamePatterns": [],
    }
    try:
        plugin_fd = open_verified_directory(plugin_dir)
        try:
            config_fd = open_regular_at(plugin_fd, "config.json", MAX_CONFIG_BYTES)
            if config_fd is None:
                return defaults
            try:
                raw = read_bounded(config_fd, MAX_CONFIG_BYTES)
            finally:
                os.close(config_fd)
        finally:
            os.close(plugin_fd)
        data = json.loads(raw.decode("utf-8"))
        if not isinstance(data, dict):
            return defaults
        allowed_keys = set(defaults)
        if not set(data).issubset(allowed_keys):
            return defaults
        result = dict(defaults)
        for key in (
            "disableOnUsbMouse",
            "disableOnBluetoothMouse",
            "disableOnOtherMouse",
            "restoreOnDisconnect",
            "notify",
        ):
            if type(data.get(key)) is not bool:
                return defaults
            result[key] = data[key]
        patterns = data.get("ignoreNamePatterns")
        if isinstance(patterns, list) and len(patterns) <= MAX_PATTERNS:
            bounded: list[str] = []
            for value in patterns:
                if not isinstance(value, str) or len(value) > MAX_PATTERN_CHARS:
                    return defaults
                if any(ord(char) < 32 or 0x7F <= ord(char) <= 0x9F for char in value):
                    return defaults
                if value:
                    bounded.append(value)
            result["ignoreNamePatterns"] = bounded
        elif patterns is not None:
            return defaults
        return result
    except (OSError, UnicodeError, json.JSONDecodeError, HelperError):
        return defaults


def bounded_json(value: object) -> bytes:
    payload = json.dumps(value, ensure_ascii=True, separators=(",", ":")).encode("ascii") + b"\n"
    if len(payload) > MAX_JSON_BYTES:
        raise HelperError("JSON output exceeds byte limit")
    return payload


def emit_json(value: object) -> None:
    sys.stdout.buffer.write(bounded_json(value))


def read_process_output(
    command: list[str],
    deadline: float,
    *,
    call_seconds: float = UDEVADM_CALL_SECONDS,
    max_output_bytes: int = MAX_UDEV_OUTPUT_BYTES,
) -> bytes:
    if deadline - time.monotonic() <= 0:
        raise TimeoutError
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    assert process.stdout is not None
    fd = process.stdout.fileno()
    os.set_blocking(fd, False)
    chunks: list[bytes] = []
    total = 0
    try:
        per_call_deadline = min(deadline, time.monotonic() + call_seconds)
        while True:
            wait = per_call_deadline - time.monotonic()
            if wait <= 0:
                raise TimeoutError
            readable, _, _ = select.select([fd], [], [], wait)
            if not readable:
                raise TimeoutError
            chunk = os.read(fd, 8192)
            if chunk:
                total += len(chunk)
                if total > max_output_bytes:
                    raise HelperError("process output exceeds byte limit")
                chunks.append(chunk)
                continue
            return_code = process.wait(timeout=max(0.01, per_call_deadline - time.monotonic()))
            if return_code != 0:
                raise HelperError(f"process exited with status {return_code}")
            return b"".join(chunks)
    finally:
        if process.poll() is None:
            try:
                os.killpg(process.pid, 15)
                process.wait(timeout=0.1)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(process.pid, 9)
                except ProcessLookupError:
                    pass
                process.wait()
        process.stdout.close()


def parse_udev_export(raw: bytes) -> list[tuple[str, dict[str, str]]]:
    """Parse bounded `udevadm info --export-db` records without shell parsing."""
    records: list[tuple[str, dict[str, str]]] = []
    for block in raw.decode("utf-8", errors="replace").split("\n\n"):
        properties: dict[str, str] = {}
        node = ""
        for line in block.splitlines():
            line = line.rstrip("\r")
            if line.startswith("N: "):
                node = line[3:].strip()
                continue
            if not line.startswith("E: "):
                continue
            key, separator, value = line[3:].partition("=")
            if separator and key and len(key) <= 128 and len(value) <= 4096:
                properties[key] = value
        event = properties.get("DEVNAME", "")
        if not event and node.startswith("input/"):
            event = "/dev/" + node
        if EVENT_PATH.fullmatch(event):
            records.append((event, properties))
    return records


def safe_device_name(properties: dict[str, str], event: str) -> str:
    name = properties.get("NAME", "").strip().strip('"')
    if not name:
        name = properties.get("ID_MODEL", "").replace("_", " ")
    if not name:
        name = properties.get("ID_SERIAL", "").replace("_", " ")
    if not name:
        name = os.path.basename(event)
    name = "".join(
        char if not (ord(char) < 32 or 0x7F <= ord(char) <= 0x9F) else " "
        for char in name
    )
    return " ".join(name.split())[:MAX_DEVICE_NAME_CHARS]


def detect() -> dict:
    deadline = time.monotonic() + DETECT_DEADLINE_SECONDS
    devices: list[dict[str, str]] = []
    counts = {"usb": 0, "bluetooth": 0, "other": 0}
    raw = read_process_output(
        ["udevadm", "info", "--export-db", "--subsystem-match=input"],
        deadline,
        call_seconds=DETECT_DEADLINE_SECONDS,
    )
    records = parse_udev_export(raw)
    if len(records) > MAX_DEVICES:
        raise HelperError("input device count exceeds limit")
    seen_events: set[str] = set()
    for event, properties in records:
        if event in seen_events:
            continue
        seen_events.add(event)
        if properties.get("ID_INPUT_MOUSE") != "1":
            continue
        if properties.get("ID_INPUT_TOUCHPAD") == "1":
            continue
        if properties.get("ID_INPUT_POINTINGSTICK") == "1":
            continue
        bus = properties.get("ID_BUS", "other")
        if bus not in ("usb", "bluetooth"):
            bus = "other"
        counts[bus] += 1
        devices.append({"name": safe_device_name(properties, event), "bus": bus})
    return {
        "usb": counts["usb"],
        "bluetooth": counts["bluetooth"],
        "other": counts["other"],
        "total": sum(counts.values()),
        "devices": devices,
    }


def touchpad_device(deadline: float) -> str:
    raw = read_process_output(
        ["omarchy-hw-touchpad"],
        deadline,
        call_seconds=1.0,
        max_output_bytes=4096,
    )
    device = raw.decode("utf-8", errors="strict").strip()
    if (
        not device
        or len(device) > MAX_DEVICE_NAME_CHARS
        or any(ord(char) < 32 or 0x7F <= ord(char) <= 0x9F for char in device)
    ):
        raise HelperError("no valid touchpad device found")
    return device


def set_hyprland_touchpad(device: str, enabled: bool, deadline: float) -> None:
    escaped = device.replace("\\", "\\\\").replace('"', '\\"')
    expression = f'hl.device({{ name = "{escaped}", enabled = {str(enabled).lower()} }})'
    read_process_output(
        ["hyprctl", "eval", expression],
        deadline,
        call_seconds=1.0,
        max_output_bytes=16 * 1024,
    )


def notify_touchpad(enabled: bool) -> None:
    try:
        read_process_output(
            ["omarchy-osd", "-i", "touchpad", "-m", f"Touchpad {'enabled' if enabled else 'disabled'}"],
            time.monotonic() + 1.0,
            call_seconds=0.75,
            max_output_bytes=4096,
        )
    except (OSError, HelperError, TimeoutError, subprocess.TimeoutExpired):
        pass


def change_touchpad(action: str, notify: bool) -> None:
    deadline = time.monotonic() + 2.5
    device = touchpad_device(deadline)
    state_fd = open_private_state_dir()
    state_lock_fd = lock_directory(state_fd)
    try:
        if action == "off":
            try:
                set_hyprland_touchpad(device, False, deadline)
                write_touchpad_state(device, state_fd)
                set_managed(True, state_fd)
            except Exception:
                try:
                    remove_touchpad_state(state_fd)
                except Exception:
                    pass
                try:
                    set_managed(False, state_fd)
                except Exception:
                    pass
                try:
                    set_hyprland_touchpad(device, True, time.monotonic() + 1.0)
                except Exception:
                    pass
                raise
            if notify:
                notify_touchpad(False)
            return

        # Apply the live state first. Persistence and ownership are cleared only
        # after the device transition succeeds, so a failed attempt is retryable.
        set_hyprland_touchpad(device, True, deadline)
        remove_touchpad_state(state_fd)
        set_managed(False, state_fd)
        if notify:
            notify_touchpad(True)
    finally:
        os.close(state_lock_fd)
        os.close(state_fd)


def restore_if_managed() -> None:
    state_fd = open_private_state_dir()
    state_lock_fd = lock_directory(state_fd)
    try:
        if not marker_exists_at(state_fd):
            return
        device = touchpad_device(time.monotonic() + 1.5)
        set_hyprland_touchpad(device, True, time.monotonic() + 1.0)
        remove_touchpad_state(state_fd)
        set_managed(False, state_fd)
    finally:
        os.close(state_lock_fd)
        os.close(state_fd)


def config_command(argv: list[str]) -> None:
    if len(argv) != 1:
        fail("usage: plugin-helper config PLUGIN_DIR")
    emit_json({"schemaVersion": 1, "type": "config", **parse_config(Path(argv[0]))})


def detect_command() -> None:
    try:
        emit_json({"schemaVersion": 1, "type": "detection", "ok": True, **detect()})
    except TimeoutError:
        emit_json({
            "schemaVersion": 1,
            "type": "detection",
            "ok": False,
            "error": "timeout",
            "usb": 0,
            "bluetooth": 0,
            "other": 0,
            "total": 0,
            "devices": [],
        })


def state_command() -> None:
    state = state_snapshot()
    emit_json({
        "schemaVersion": 1,
        "type": "state",
        **state,
    })


def main(argv: list[str]) -> None:
    if not argv:
        fail("usage: plugin-helper <config|detect|state|managed|clear-managed|clear-touchpad-state|touchpad|restore>")
    command, args = argv[0], argv[1:]
    try:
        if command == "config":
            config_command(args)
        elif command == "detect" and not args:
            detect_command()
        elif command == "state" and not args:
            state_command()
        elif command == "managed" and not args:
            set_managed(True)
        elif command == "clear-managed" and not args:
            set_managed(False)
        elif command == "clear-touchpad-state" and not args:
            remove_touchpad_state()
        elif command == "touchpad" and args and args[0] in ("on", "off"):
            if len(args) > 2 or (len(args) == 2 and args[1] != "--notify"):
                fail("usage: plugin-helper touchpad <on|off> [--notify]")
            change_touchpad(args[0], len(args) == 2)
        elif command == "restore" and not args:
            restore_if_managed()
        else:
            fail("unknown command")
    except (OSError, HelperError, TimeoutError, UnicodeError, subprocess.TimeoutExpired) as error:
        fail(str(error))


if __name__ == "__main__":
    main(sys.argv[1:])
